-- Generated by aurdeck. Private overlay init.lua; do not edit.
--
-- Pins reviewed AUR commits with yay v13's real Lua hook API (docs/yay-lua-hooks.md):
-- yay aborts before it builds any package base whose fetched clone is not the commit and
-- PKGBUILD approved in aurdeck. Every path that cannot prove a match aborts.
--
-- Order matters:
--   (a) capture every global the check uses as a local and build the approved table;
--   (b) put the user's config dir on package.path and load the user's own init.lua;
--   (c) register the pin LAST, through the captured create_autocmd, so it runs after any
--       user callback (callbacks run in registration order).
-- The overlay spawns no process and loads no module itself (no shell strings).
--
-- Honest limit: the user's own init.lua runs in this Lua state with the user's full
-- privileges. The pin protects against a changed AUR clone, not against a malicious
-- user config.

-- (a) Captured before any user code runs.
local type, tostring, pairs, pcall, dofile, error = type, tostring, pairs, pcall, dofile, error
local print, getmetatable = print, getmetatable
local io_open = io.open
local s_match, s_sub, s_find, s_gsub, s_len =
  string.match, string.sub, string.find, string.gsub, string.len
local yay_t = yay

if type(yay_t) ~= "table" or type(yay_t.create_autocmd) ~= "function" then
  error("aurdeck: this yay has no Lua hook API (yay.create_autocmd); it cannot pin reviewed commits")
end
local create_autocmd = yay_t.create_autocmd
local abort = yay_t.abort

-- File-handle methods, called as functions (read(h, ...)), not h:read(...).
local read, close
do
  local meta = getmetatable(io.stdin)
  local methods = type(meta) == "table" and meta.__index or nil
  if type(methods) == "table" then
    read, close = methods.read, methods.close
  end
  if type(read) ~= "function" or type(close) ~= "function" then
    error("aurdeck: cannot capture the file handle methods; refusing to run (fail closed)")
  end
end

-- pkgbase -> reviewed commit and PKGBUILD text.
local approved = {
@@APPROVED@@
}

local user_init = @@USER_INIT@@
local user_dir = @@USER_DIR@@

-- (b) The user's config dir first on package.path, then their init.lua (errors are
-- reported, not fatal).
if user_dir ~= nil then
  package.path = user_dir .. "/?.lua;" .. user_dir .. "/?/init.lua;" .. package.path
end
if user_init ~= nil then
  local ok, err = pcall(dofile, user_init)
  if not ok then
    print("aurdeck: error in user init.lua: " .. tostring(err))
  end
end

-- (c) The pin. Uses only the locals captured above.
local function fail(msg)
  if type(abort) == "function" then
    abort(msg)
  end
  error(msg)
end

local function is_hash(s)
  if type(s) ~= "string" then
    return false
  end
  local n = s_len(s)
  return (n == 40 or n == 64) and s_match(s, "^[0-9a-f]+$") ~= nil
end

-- First line of a file without its line ending, or nil.
local function first_line(path)
  local h = io_open(path, "r")
  if h == nil then
    return nil
  end
  local line = read(h, "*l")
  close(h)
  if type(line) ~= "string" then
    return nil
  end
  return (s_gsub(line, "%s+$", ""))
end

-- The commit of the clone in `dir`, read without a shell, or nil.
local function read_commit(dir)
  local head = first_line(dir .. "/.git/HEAD")
  if head == nil then
    return nil
  end
  if is_hash(head) then
    return head -- detached HEAD
  end
  local ref = s_match(head, "^ref: (.+)$")
  if ref == nil or s_sub(ref, 1, 1) == "/" or s_find(ref, "..", 1, true) ~= nil
    or s_find(ref, "[%c\\]") ~= nil then
    return nil
  end
  local loose = first_line(dir .. "/.git/" .. ref)
  if loose ~= nil then
    if is_hash(loose) then
      return loose
    end
    return nil -- unreadable or symbolic: cannot prove anything
  end
  local h = io_open(dir .. "/.git/packed-refs", "r")
  if h == nil then
    return nil
  end
  local found = nil
  while true do
    local line = read(h, "*l")
    if line == nil then
      break
    end
    local hash, name = s_match(line, "^(%S+) (.-)%s*$")
    if hash ~= nil and name == ref and is_hash(hash) then
      found = hash
      break
    end
  end
  close(h)
  return found
end

local function check(event)
  local data = type(event) == "table" and event.data or nil
  if type(data) ~= "table" then
    fail("aurdeck: hook event has no data; refusing to build (fail closed)")
  end
  local base = data.base
  if type(base) ~= "string" or base ~= event.match then
    fail("aurdeck: hook event has no usable package base; refusing to build (fail closed)")
  end
  local want = approved[base]
  if want == nil then
    fail("aurdeck: " .. base .. " was not reviewed in aurdeck; refusing to build")
  end
  local dir = data.dir
  if type(dir) ~= "string" or dir == "" then
    fail("aurdeck: " .. base .. ": hook event has no clone directory; refusing to build")
  end
  local commit = read_commit(dir)
  if commit == nil then
    fail("aurdeck: " .. base .. ": cannot read the fetched commit from " .. dir .. "; refusing to build")
  end
  if commit ~= want.commit then
    fail("aurdeck: " .. base .. " changed since review (approved " .. want.commit ..
      ", fetched " .. commit .. "); refusing to build")
  end
  if want.pkgbuild == nil then
    -- Only an entry made through the commit-only constructor may skip the text check.
    if want.pkgbuild_unchecked ~= true then
      fail("aurdeck: " .. base .. ": no reviewed PKGBUILD text on record; refusing to build")
    end
  elseif data.pkgbuild ~= want.pkgbuild then
    fail("aurdeck: " .. base .. ": the PKGBUILD differs from the reviewed one at " .. commit ..
      "; refusing to build")
  end
end

create_autocmd("AURPreInstall", { desc = "aurdeck review pin", callback = check })
create_autocmd("AURPostDownload", { desc = "aurdeck review pin", callback = check })
